class Solution {
public:
    int maxArea(vector<int>& height) {
        int left = 0;
        int right = height.size()-1;
        int max_S = 0;
        while(left < right){
            int S = min(height[left],height[right])*(right-left);
            max_S = max(max_S,S);
            if(height[left]<height[right]){
                left++;
            }
            else{
                right--;
            }
        }
        return max_S;
    }
};
