//f(n) = n! * (n*(n-1) / 2) + n * f(n-1)
#include<iostream>
using namespace std;
long long factorial(int n)
{
	if(n == 1) return 1;
	return n* factorial(n-1);
}
long long f(long long n)
{
	if(n == 1) return 0;
	return factorial(n-1)*(n*(n-1) / 2) + n*f(n-1);
}
int main()
{
	long long n;
	cin >> n;
	cout << f(n) << endl;
	return 0;
}
