class Solution:
    def exist(self, board: List[List[str]], word: str) -> bool:
        m, n = len(board), len(board[0])
        
        def dfs(x, y, idx):
            if idx == len(word):
                return True
            
            if x < 0 or x >= m or y < 0 or y >= n or board[x][y] != word[idx]:
                return False
            
            tmp = board[x][y]
            board[x][y] = '#'   # ⭐ 标记
            
            for dx, dy in [(-1,0),(1,0),(0,-1),(0,1)]:
                if dfs(x+dx, y+dy, idx+1):
                    return True
            
            board[x][y] = tmp   # ⭐ 恢复
            return False
        
        for i in range(m):
            for j in range(n):
                if dfs(i, j, 0):
                    return True
        
        return False
            
