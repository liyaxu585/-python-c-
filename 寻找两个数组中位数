#include<iostream>
#include<random>
#include<algorithm>
#include<ctime>
#include<vector>
using namespace std;
double findMiddle(vector<int>& nums1, const int length1, vector<int>& nums2, const int length2)
{
	if (length2 > length1)
	{
		return findMiddle(nums2, length2, nums1, length1);
	}
	int k = (length1 + length2 + 1) / 2;
	int start = 0;
	int end = length1 - 1;
	int i = 0;
	int j = 0;
	while (start <= end)
	{
		i = (start + end + 1) / 2;
		j = k - i;
		//如果第一个数组的i-1个比第二个数组的第j个还大,证明第一个数组数字太大了,end往中间移动
		if (i > 0 && j < length2 && nums1[i - 1] > nums2[j])
		{
			end = i - 1;
		}
		//如果第一个数组的第i个数还没第二个数组的j-1个数大,同理,start往前移
		else if (j > 0 && i < length1 && nums1[i] < nums2[j - 1])
		{
			start = i + 1;
		}
		//如果两种情况都不满足,证明找到合适的i和j了
		else
		{
			break;
		}
	}
	//然后我们来讨论中位数的需要的个数,偶数时,两个
	//考虑特殊情况
	//如果i == 0,证明数组一的值很少并且都很大
	//如果j == 0;证明数组一的值很少并且很小
	int left = 0;
	if (i == 0)//左半部分没有元素,左半部分的元素全在第二个数组
	{
		left = nums2[j - 1];
	}
	else if (j == 0)//第二个数组左半部分没有元素,左半部分全在第一个数组
	{
		left = nums1[i - 1];
	}
	else
	{
		left = max(nums1[i - 1], nums2[j - 1]);
	}
	int right = 0;
	//数组一全部都很小
	if (i == length1)//数组一右半部分没有数字
	{
		right = nums2[j];
	}
	else if (j == length2)
	{
		right = nums1[i];
	}
	else
	{
		right = min(nums1[i], nums2[j]);
	}
	if ((length1 + length2) % 2 != 0)
	{
		return left;
	}
	else
	{
		return (right + left) * 1.0 / 2;
	}
}
int main()
{
	srand((unsigned)time(NULL));
	vector<int> nums1;
	vector<int> nums2;
	int length1 = rand() % 10 + 2;
	int length2 = rand() % 15 + 2;
	for (int i = 0; i < length1;i++)
	{
		nums1.push_back(rand() % 100);
	}
	for (int j = 0; j < length2; j++)
	{
		nums2.push_back(rand() % 100);
	}
	sort(nums1.begin(), nums1.end());
	sort(nums2.begin(), nums2.end());
	for (int v : nums1)
	{
		cout << v << " ";
	}
	cout << endl;
	for (int u : nums2)
	{
		cout << u << " ";
	}
	cout << endl;
	int middle = findMiddle(nums1, length1, nums2, length2);
	cout << "中位数:" << middle << endl;
	return 0;
}
