class Solution {
public:
    int subarraySum(vector<int>& nums, int k) {
        unordered_map<int,int> prev_dict;
        prev_dict[0] = 1;
        int num_sum = 0;
        int count = 0;
        int m = nums.size();
        for(int i = 0;i < m;i++){
            num_sum += nums[i];
            if(prev_dict.count(num_sum-k)){
                count += prev_dict[num_sum-k];
            }
            prev_dict[num_sum]++;
        }
        return count;
    }
};
