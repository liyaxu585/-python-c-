class Solution {
public:
    void dfs(string& path,vector<string>& res,int n,int i,int j){
        if(i ==n && j == n){
            res.push_back(path);
            return;
        }
        if(i < n){
            path.push_back('(');
            dfs(path,res,n,i+1,j);
            path.pop_back();
        }
        if(i > j){
            path.push_back(')');
            dfs(path,res,n,i,j+1);
            path.pop_back();
        }
    }
    vector<string> generateParenthesis(int n) {
        string path = "";
        vector<string> res;
        dfs(path,res,n,0,0);
        return res;
    }
};



class Solution:
    def generateParenthesis(self, n: int) -> List[str]:
        res = []
        path = []
        def dfs(i,j):
            if i == j == n:
                res.append(''.join(path))
                return
            if i < n:
                path.append('(')
                dfs(i+1,j)
                path.pop()
            if j < i:
                path.append(')')
                dfs(i,j+1)
                path.pop()
        dfs(0,0)
        return res
