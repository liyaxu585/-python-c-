#include<iostream>
#include<vector>
#include<ctime>
#include<random>
#include<algorithm>
#include<cmath>
using namespace std;
//给定一组整数,从里面挑选出一堆整数,让整数和和剩下的整数和最小
void func(int i, const vector<int>& arr, int& result, int sum, int left_)
{
	if (i == arr.size())
	{
		result = min(result, abs(sum - left_));
		return;
	}
	func(i + 1, arr, result, sum + arr[i], left_ - arr[i]);
	func(i + 1, arr, result, sum, left_);
}
int main()
{
	srand((unsigned)time(NULL));
	vector<int> arr;
	const int INF = 0x3f3f3f3f;
	int result = INF;
	int sum = 0;
	int left_ = 301;
	for (int i = 0; i < 10; i++)
	{
		int num = rand() % 100;
		arr.push_back(num);
		left_ += num;
	}

	for (int num : arr)
	{
		cout << num << " ";
	}
	cout << endl;
	func(0, arr, result, sum, left_);
	cout << "最小差:" << result << endl;
	return 0;
}
