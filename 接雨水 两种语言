class Solution {
public:
    int trap(vector<int>& height) {
        int m = height.size();
        if(m<3){
            return 0;
        }
        vector<int> max_left(m);
        vector<int> max_right(m);
        int left_H = 0;
        int right_H = 0;
        for(int i = 0;i < m;i++){
            max_left[i] = left_H;
            left_H = max(left_H,height[i]);
        }
        for(int i = m-1;i >= 0;i--){
            max_right[i] = right_H;
            right_H = max(right_H,height[i]);
        }
        int max_S = 0;
        for(int i = 0;i < m;i++){
            if(height[i] < min(max_left[i],max_right[i])){
                max_S += min(max_left[i],max_right[i])-height[i];
            }
        }
        return max_S;
    }
};




class Solution:
    def trap(self, height: List[int]) -> int:
        m = len(height)
        if m < 3:
            return 0
        max_left = [0] * m
        max_right = [0] * m
        left_H = 0
        right_H = 0
        for i in range(m):
            max_left[i] = left_H
            left_H = max(left_H,height[i])
        for i in range(m-1,-1,-1):
            max_right[i] = right_H
            right_H = max(right_H,height[i])
        max_S = 0
        for i in range(m):
            if height[i] < min(max_left[i],max_right[i]):
                max_S += min(max_left[i],max_right[i])-height[i]
        return max_S
