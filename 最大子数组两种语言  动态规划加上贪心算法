        #状态转移方程 动态规划
        m = len(nums)
        dp = [0] * m
        dp[0] = nums[0]
        max_num = dp[0]
        for i in range(1,m):
            dp[i] = max(dp[i-1]+nums[i],nums[i])
            max_num = max(max_num,dp[i])
        return max_num


            
