class Solution {
public:
    int maxSubArray(vector<int>& nums) {
        /*
        动态规划方法
        int m = nums.size();
        vector<int> dp(m,0);
        dp[0] = nums[0];
        int max_sum = nums[0];
        for(int i = 1;i < m;i++){
            dp[i] = max(dp[i-1]+nums[i],nums[i]);
