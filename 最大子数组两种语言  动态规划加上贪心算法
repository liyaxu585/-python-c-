        }
        return max_sum;*/
        //贪心算法
        int m = nums.size();
        int current_sum = 0;
        int max_sum = nums[0];
        for(int i = 0;i < m;i++){
            current_sum+=nums[i];
            if(current_sum < nums[i]){
                current_sum = nums[i];
            }
            max_sum = max(max_sum,current_sum);
        }
        return max_sum;
    }
};




class Solution:
    def maxSubArray(self, nums: List[int]) -> int:
        #贪心算法
        '''m = len(nums)
        if m == 1:
            return nums[0]
        current_sum = 0
