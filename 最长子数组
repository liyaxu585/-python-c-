#include<iostream>
#include<random>
#include<ctime>
#include<vector>
using namespace std;
//找最大和的子数组
int main()
{
	vector<int> nums;
	for (int i = 0; i < 10; i++)
	{
		nums.push_back(rand() % 100-50);
	}
	int n = nums.size();
	int dp[10] = { 0 };
	dp[0] = nums[0] < 0 ? 0 : nums[0];
	int maxVal = dp[0];
	for (int i = 1; i < n; i++)
	{
		dp[i] = dp[i - 1] + nums[i];
		if (dp[i] < 0)
		{
			dp[i] = 0;
		}
		if (dp[i] > maxVal)
		{
			maxVal = dp[i];
		}
	}
	cout << maxVal << endl;
	return 0;
}
