#include<iostream>
#include<random>
#include<ctime>
#include<vector>
using namespace std;
int main()
{
	srand((unsigned)time(NULL));
	vector<int> nums;
	for (int i = 0; i < 10; i++)
	{
		nums.push_back(rand() % 100);
	}
	int maxVal = 0;
	int dp[10] = { 0 };
	for (int i = 0; i < 10; i++)
	{
		dp[i] = 1;
		for (int j = 0; j < i; j++)
		{
			if (nums[i] > nums[j] && dp[i] < dp[j] + 1)
			{
				dp[i] = dp[j] + 1;
			}
		}
		if (dp[i] > maxVal)
		{
			maxVal = dp[i];
		}
	}
	for(int v : nums)
	{
		cout << v << " ";
	}
	cout << endl;
	cout << maxVal << endl;
	return 0;
}
