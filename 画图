#include<iostream>
using namespace std;
void draw(int w,int h,int v)
{
	for(int i = 1;i <= h;i++)
	{
		for(int j = 1;j <= w;j++)
		{
			cout << 'Q';
		}
		cout << endl;
	}
	for(int i = 1;i <= w;i++)
	{
		for(int j = 1;j <= w + v;j++)
		{
			cout << 'Q';
		}
		cout << endl;
	}
}
int main()
{
	int w,h,v;
	cin >> w>>h>>v;
	draw(w,h,v);
	return 0;
 } 
