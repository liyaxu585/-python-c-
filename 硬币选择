#include<iostream>
using namespace std;
int lesscoin(int dp[], int n)//返回的是最少硬币数
{
	if (dp[n] > 0)//证明子问题已经得到解决,直接返回
	{
		return dp[n];
	}
	if (n == 1 || n == 3 || n == 5)
	{
		dp[n] = 1;
		return 1;
	}
	else if (n == 2 || n == 4)
	{
		dp[n] = 2;
		return 2;
	}
	else
	{
		int n1 = lesscoin(dp, n - 1) + 1;
		int n2 = lesscoin(dp, n - 3) + 1;
		int n3 = lesscoin(dp, n - 5) + 1;
		return min((n1, n2), n3);
	}
}
int main()
{
	const int n = 23;
	int dp[n + 1] = { 0 };//记录面值为n的最少硬币数
	int num = lesscoin(dp,n);
	cout << "最少硬币数:" << num << endl;
	return 0;
}
