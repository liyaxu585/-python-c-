#include<iostream>
using namespace std;
int main()
{
	int v[3] = { 1,3,5 };
	int n = 23;
	int* dp = new int[n + 1]();
	int length = sizeof(v) / sizeof(v[0]);
	for (int i = 0; i <= n; i++)
	{
		dp[i] = i;//初始化为全部由一分硬币组成
		for(int j = 0; j < length; j++)
		{
			if (dp[i] > (dp[i - v[j]]+1) && i >= v[j])
			{
				dp[i] = dp[i - v[j]] + 1;
			}
		}
	}
	cout << dp[n] << endl;
	return 0;
}
